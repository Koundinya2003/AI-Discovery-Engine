# ── Required for the inductive (model) layer ────────────────────────────
#
# The deductive frame, the opportunity table, the segment cuts and every
# coverage number work WITHOUT any of these. A run with no keys at all still
# collects from Reddit and the two app stores, labels 100% of what it finds,
# and ranks opportunities — it just can't induce new themes or answer
# free-text questions. Nothing below ever reaches the browser.

# Groq API key — free tier, get one at https://console.groq.com/keys
GROQ_API_KEY=

# Pinned explicitly on purpose — never auto-routed. See README for why.
GROQ_MODEL=openai/gpt-oss-120b

# ── Community collector (Reddit) ────────────────────────────────────────
# No key needed: Reddit's public JSON endpoints are used directly.
#
# Comma-separated subreddits to search. Defaults to the six in
# lib/collectors/reddit.ts if unset.
REDDIT_SUBREDDITS=

# Cap on total Reddit posts collected per run.
REDDIT_MAX_ITEMS=200

# ── YouTube collector (optional) ────────────────────────────────────────
# YouTube Data API v3 key (free quota: 10,000 units/day). Without this the
# YouTube source reports a clean "not configured" state and the run proceeds.
YOUTUBE_API_KEY=

# ── Sampling & model budget ─────────────────────────────────────────────
# How many items the model layer samples and classifies per run. This is the
# ONLY number that limits coverage: the deductive frame always covers 100% of
# the corpus. The default is sized to this account's measured Groq free-tier
# ceiling (8,000 TPM for the pinned reasoning model) — see README
# "Tuning & limits" before raising it.
CLASSIFY_MAX_ITEMS=48

# Seed for the deterministic stratified sample. Change it to draw a different
# sample; keep it to reproduce a previous run's sample exactly.
SAMPLE_SEED=discovery-engine-v2

# ── Rate limiting, caching & run permalinks (optional, free tier) ───────
# Upstash Redis (REST-based, free tier: https://console.upstash.com/) backs
# per-IP rate limiting, a short-lived result cache, AND saved runs — /run/{id}
# permalinks only resolve when this is configured. Without it the app runs
# fine; the UI just says permalinks are unavailable instead of handing out a
# link that would 404 from a slide.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max /api/discover requests per IP per 10-minute window.
DISCOVER_RATE_LIMIT=5

# Max /api/ask requests per IP per 10-minute window.
ASK_RATE_LIMIT=20

# How long a cached discover result stays valid, in seconds.
DISCOVER_CACHE_TTL_SECONDS=3600

# How long a saved run stays resolvable at /run/{id}, in seconds.
RUN_TTL_SECONDS=2592000

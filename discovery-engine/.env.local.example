# ── Required ────────────────────────────────────────────────────────────

# Groq API key — free tier, get one at https://console.groq.com/keys
GROQ_API_KEY=

# Pinned explicitly on purpose — never auto-routed. See README for why.
GROQ_MODEL=openai/gpt-oss-120b

# ── YouTube collector ───────────────────────────────────────────────────
# YouTube Data API v3 key (free quota: 10,000 units/day). Without this the
# YouTube collector is skipped and other sources still run.
YOUTUBE_API_KEY=

# ── Forum collector ─────────────────────────────────────────────────────
# Which search API to use for the forum search-then-fetch step:
# "google_cse" (default), "bing", or "serpapi". Configure the matching
# key(s) below for whichever you pick. Without a provider configured, the
# forum collector is skipped and other sources still run.
SEARCH_PROVIDER=google_cse

# Google Programmable Search Engine (Custom Search JSON API) — 100 free
# queries/day. Create a CSE at https://programmablesearchengine.google.com/
# and an API key at https://console.cloud.google.com/apis/credentials
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Bing Web Search API key (alternative to Google CSE)
BING_SEARCH_API_KEY=

# SerpAPI key (alternative to Google CSE)
SERPAPI_API_KEY=

# Comma-separated list of community domains to search for forum discussions.
# Reddit is deliberately excluded — see README "Compliance" section.
FORUM_DOMAINS=onlytechforum.in,pissedconsumer.com,quora.com

# Cap on total forum items collected per run.
FORUM_MAX_ITEMS=120

# ── Tuning (optional) ───────────────────────────────────────────────────
# Cap on how many collected items get sent through Groq classification per
# run. 36 (a handful of 10-item batches) is what a free-tier Groq account can
# reliably classify with real theme codes in one request — measured live via
# response headers, the pinned model's actual cap is 8,000 TPM (not the
# 6,000 the docs advertise), and pass-1 theme discovery alone uses ~4,200 of
# that before classification even starts. Raising this without more TPM
# headroom (Groq Dev Tier) means later batches silently fall back to OTH
# instead of a real theme — see README "Tuning & limits". Raw scraped counts
# are unaffected either way.
CLASSIFY_MAX_ITEMS=36

# ── Rate limiting & caching (optional, free tier) ──────────────────────
# Upstash Redis (REST-based, free tier: https://console.upstash.com/) backs
# per-IP rate limiting on /api/discover and /api/ask, plus a short-lived
# cache of discover results so repeat searches for the same product don't
# re-burn Groq/YouTube/Google-CSE quota. Without these set, the app runs
# exactly as before — no rate limiting, no caching, nothing blocks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max /api/discover requests per IP per 10-minute window.
DISCOVER_RATE_LIMIT=5

# Max /api/ask requests per IP per 10-minute window.
ASK_RATE_LIMIT=20

# How long a cached discover result stays valid, in seconds.
DISCOVER_CACHE_TTL_SECONDS=3600

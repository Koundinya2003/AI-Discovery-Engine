# ── Required ────────────────────────────────────────────────────────────
# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Optional ────────────────────────────────────────────────────────────
# OpenRouter model to use (default: openrouter/free)
OPENROUTER_MODEL=openrouter/free

# YouTube Data API v3 key (required only for the YouTube Comments source)
YOUTUBE_API_KEY=

# GitHub personal access token (optional; increases rate limits for GitHub Issues)
GITHUB_TOKEN=